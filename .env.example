# 复制为 .env 后填写模型服务配置；不要提交真实密钥。
TIDEBOUND_MODE=dev
TIDEBOUND_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
TIDEBOUND_LLM_MODEL=glm-5.3
TIDEBOUND_LLM_API_KEY=
# codex789 中转；填好后重启，可在管理员 Console 切换主聊天来源。
TIDEBOUND_RELAY_BASE_URL=https://www.codex789.com/v1
TIDEBOUND_RELAY_MODEL=glm-5.3
TIDEBOUND_RELAY_API_KEY=
# 硅基流动可改用 https://api.siliconflow.cn/v1 与 zai-org/GLM-5.3。
# 切换供应商时须同时核对下方欢迎模型名称；不能只替换 API Key。
TIDEBOUND_TIMEZONE=Asia/Shanghai
TIDEBOUND_MAX_MODEL_CALLS=4
TIDEBOUND_MAX_OUTPUT_TOKENS=8192
TIDEBOUND_CONTEXT_LIMIT=32768
TIDEBOUND_RUN_TIMEOUT=120

# 开启后在后端终端实时打印模型返回的思考、回复与工具执行。
TIDEBOUND_DEBUG=false
# GLM-5.3 可选 low / high / max；其他供应商不支持时移除此项。
TIDEBOUND_LLM_REASONING_EFFORT=low

# 本地账号数据库；密码自行设置，不能提交真实凭据。
TIDEBOUND_MYSQL_HOST=127.0.0.1
TIDEBOUND_MYSQL_PORT=53306
TIDEBOUND_MYSQL_DATABASE=tidebound
TIDEBOUND_MYSQL_USER=tidebound
TIDEBOUND_MYSQL_PASSWORD=
TIDEBOUND_MYSQL_ROOT_PASSWORD=

# 登录欢迎工作流，独立模型；地址和凭据留空时复用主模型服务。
TIDEBOUND_MEET_MODEL=glm-5.3-flash
TIDEBOUND_MEET_BASE_URL=
TIDEBOUND_MEET_API_KEY=
TIDEBOUND_MEET_TIMEOUT=30

# 博查 Web Search API 密钥；在 https://open.bocha.cn 申请。
# 搜索及兴趣更新共用；不使用模型渠道 Key 或旧 Brave Key。
TIDEBOUND_BOCHA_API_KEY=

# 搜索工作流专用模型；空地址和 Key 复用原始 LLM 配置，不随 Console 中转选择变化
TIDEBOUND_WEBSEARCH_MODEL=deepseek-ai/DeepSeek-V4-Flash
TIDEBOUND_WEBSEARCH_BASE_URL=
TIDEBOUND_WEBSEARCH_API_KEY=
