# 复制为压缩包根目录的 .env，填写真实值后运行 ./deploy.sh。
TIDEBOUND_PUBLIC_PORT=8080
TIDEBOUND_LLM_BASE_URL=https://api.siliconflow.cn/v1
TIDEBOUND_LLM_MODEL=zai-org/GLM-5.3
# 可在各账号的模型接口设置中保存自己的密钥；此全局值可留空。
TIDEBOUND_LLM_API_KEY=
TIDEBOUND_MYSQL_PASSWORD=
TIDEBOUND_MYSQL_ROOT_PASSWORD=
TIDEBOUND_TIMEZONE=Asia/Shanghai
TIDEBOUND_CONTEXT_LIMIT=65536
TIDEBOUND_MAX_OUTPUT_TOKENS=8192
TIDEBOUND_ROLLING_SUMMARY_CONTEXT_LIMIT=65536
TIDEBOUND_ROLLING_SUMMARY_MAX_BYTES=20000
# 可选搜索能力：
TIDEBOUND_BOCHA_API_KEY=
